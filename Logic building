# ==========================================
# Q6. Check whether a number is prime.
#
# Example:
# Input: 29
# Output: Prime number
# ==========================================

num = int(input("Enter a number: "))

is_prime = True

if num < 2:
    is_prime = False
else:
    for i in range(2, num):
        if num % i == 0:
            is_prime = False
            break

if is_prime:
    print("Prime number")
else:
    print("Not a prime number")


# ==========================================
# Q7. Find the sum of digits of a number.
#
# Example:
# Input: 5832
# Output: 18
# ==========================================

num = int(input("Enter a number: "))

sum_of_digits = 0

while num > 0:
    digit = num % 10
    sum_of_digits += digit
    num //= 10

print("Sum of digits:", sum_of_digits)


# ==========================================
# Q8. Find the second smallest number
# in a list.
#
# Example:
# Input: [10, 5, 8, 2, 15]
# Output: 5
# ==========================================

numbers = [10, 5, 8, 2, 15]

smallest = float("inf")
second_smallest = float("inf")

for num in numbers:
    if num < smallest:
        second_smallest = smallest
        smallest = num
    elif num < second_smallest and num != smallest:
        second_smallest = num

print("Second smallest:", second_smallest)


# ==========================================
# Q9. Count the frequency of each number
# in a list.
#
# Example:
# Input: [2, 3, 2, 5, 3, 2]
#
# Output:
# 2 -> 3
# 3 -> 2
# 5 -> 1
# ==========================================

numbers = [2, 3, 2, 5, 3, 2]
frequency = {}

for num in numbers:
    if num in frequency:
        frequency[num] += 1
    else:
        frequency[num] = 1

for num in frequency:
    print(num, "->", frequency[num])


# ==========================================
# Q10. Check whether a number is an Armstrong
# number.
#
# Example:
# Input: 153
# Output: Armstrong number
#
# 1³ + 5³ + 3³ = 153
# ==========================================

num = int(input("Enter a number: "))

original = num
digits = len(str(num))
total = 0

while num > 0:
    digit = num % 10
    total += digit ** digits
    num //= 10

if total == original:
    print("Armstrong number")
else:
    print("Not an Armstrong number")


# ==========================================
# Q11. Remove duplicate elements from a list
# without using set().
#
# Example:
# Input: [1, 2, 2, 3, 1, 4]
# Output: [1, 2, 3, 4]
# ==========================================

numbers = [1, 2, 2, 3, 1, 4]
unique = []

for num in numbers:
    if num not in unique:
        unique.append(num)

print("Without duplicates:", unique)


# ==========================================
# Q12. Find the missing number from 1 to n.
#
# Example:
# Input: [1, 2, 3, 5]
# Output: 4
# ==========================================

numbers = [1, 2, 3, 5]

n = len(numbers) + 1

expected_sum = n * (n + 1) // 2
actual_sum = 0

for num in numbers:
    actual_sum += num

missing = expected_sum - actual_sum

print("Missing number:", missing)


# ==========================================
# Q13. Find the number that appears only once
# when every other number appears twice.
#
# Example:
# Input: [4, 1, 2, 1, 2]
# Output: 4
# ==========================================

numbers = [4, 1, 2, 1, 2]

for num in numbers:
    count = 0

    for x in numbers:
        if num == x:
            count += 1

    if count == 1:
        print("Unique number:", num)
        break
