# ==========================================
# Q1. Find the GCD (Greatest Common Divisor)
# of two numbers.
#
# Example:
# Input: 24, 36
# Output: 12
# ==========================================

a = 24
b = 36

while b != 0:
    a, b = b, a % b

print("GCD:", a)


# ==========================================
# Q2. Check whether a number is a palindrome.
#
# Example:
# Input: 121
# Output: Palindrome
# ==========================================

num = int(input("Enter a number: "))

original = num
reverse = 0

while num > 0:
    digit = num % 10
    reverse = reverse * 10 + digit
    num //= 10

if original == reverse:
    print("Palindrome")
else:
    print("Not a palindrome")


# ==========================================
# Q3. Find the factorial of a number
# using recursion.
#
# Example:
# Input: 5
# Output: 120
# ==========================================

def factorial(n):
    if n == 0 or n == 1:
        return 1

    return n * factorial(n - 1)


num = int(input("Enter a number: "))

print("Factorial:", factorial(num))


# ==========================================
# Q4. Generate the Fibonacci series
# up to n terms.
#
# Example:
# Input: 7
# Output: 0 1 1 2 3 5 8
# ==========================================

n = int(input("Enter number of terms: "))

a = 0
b = 1

for i in range(n):
    print(a, end=" ")

    a, b = b, a + b


